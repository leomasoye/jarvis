# ================================
# JARVIS — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs.
# NE JAMAIS COMMITTER .env (voir .gitignore)
# ================================

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_FAST=llama3.2:3b
OLLAMA_MODEL_ADVANCED=qwen2.5:7b

# --- Audio ---
WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8
PIPER_MODEL_PATH=data/piper_models/fr_FR-upmc-medium.onnx
AUDIO_SAMPLE_RATE=16000
VAD_THRESHOLD=0.5

# --- Mémoire ---
CHROMA_DB_PATH=data/chromadb
SQLITE_DB_PATH=data/jarvis.db
SHORT_TERM_MAX_TURNS=20

# --- Application ---
APP_LOG_LEVEL=DEBUG
APP_THEME=dark

# --- Email (Étape 6) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.email@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM_NAME=Jarvis

# --- File System (Étape 6) ---
FS_MAX_FILE_SIZE_MB=50
SHELL_TIMEOUT_SECONDS=30
SHELL_ENABLED=false

# --- Permissions (Étape 6) ---
PERMISSIONS_CONFIG=config/permissions.json
